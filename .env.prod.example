TZ=Asia/Shanghai
POSTGRES_DB=tm_demo
POSTGRES_USER=tm_user
POSTGRES_PASSWORD=change-me-postgres-password

DATABASE_URL=postgresql+psycopg://tm_user:change-me-postgres-password@pgbouncer:6432/tm_demo
DATABASE_PGBOUNCER_TRANSACTION_MODE=true
DATABASE_APPLICATION_NAME=ai-translation-web
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=20
DATABASE_POOL_RECYCLE=1800
SERVER_THREADPOOL_SIZE=16
WEB_CONCURRENCY=4

TERM_IMPORT_PREVIEW_MAX_SCAN_ROWS=5000
RESOURCE_IMPORT_PREVIEW_MAX_SCAN_ROWS=1000
RESOURCE_IMPORT_BATCH_SIZE=500
RESOURCE_IMPORT_MAX_SIZE_MB=1024
RESOURCE_IMPORT_REQUEST_OVERHEAD_MB=10
APP_ENV_FILE=.env.prod

REDIS_URL=redis://redis:6379/0
IMPORT_QUEUE_BACKEND=arq
ARQ_MAX_JOBS=5
ARQ_IMPORT_MAX_JOBS=2
ARQ_MAINTENANCE_MAX_JOBS=2
ARQ_AUTO_TM_MAX_JOBS=1
ARQ_SEGMENT_SYNC_MAX_JOBS=1
# 先对白名单项目启用失焦同步；验证稳定后可改为 *。
PROJECT_SYNC_BLUR_PROJECT_IDS=8484b379-ea20-4f9b-a32a-471e602e9055
PGBOUNCER_STATS_USERS=tm_user
ARQ_PRETRANSLATION_MAX_JOBS=2
ARQ_AI_MAX_JOBS=1
PRETRANSLATION_RUN_FILE_CONCURRENCY=2
AUTO_TM_OUTBOX_MAX_BATCHES_PER_RUN=5
AUTO_TM_REMATCH_MAX_FILES_PER_RUN=1

FILE_STORAGE_DIR=/app/data/file_records
EXPORT_TASK_DIR=/app/data/export_tasks
IMPORT_TASK_DIR=/app/data/import_tasks
IMPORT_TASK_STAGING_TTL_SECONDS=86400
UPLOAD_MAX_SIZE_MB=100
UPLOAD_MAX_FILES_PER_BATCH=50
UPLOAD_MAX_FILES_PER_SELECTION=200
UPLOAD_MAX_TOTAL_SIZE_MB=2048
UPLOAD_MAX_REQUEST_SIZE_MB=2060
UPLOAD_MAX_EXPANDED_FILES=100
AI_MAX_FILE_SIZE_MB=2048
AI_INLINE_MAX_SIZE_MB=100
AI_MIN_FREE_DISK_MB=8192
AI_WORKER_JOB_TIMEOUT_SECONDS=1800
AI_WORKER_MEMORY_LIMIT_MB=4096
AI_MAX_PAGES=200
AI_MAX_XREF_OBJECTS=250000
AI_MAX_TEXT_LINES=100000
AI_MAX_TEXT_SPANS=250000
AI_MAX_TEXT_CHARACTERS=5000000
AI_OCR_ENABLED=true
AI_OCR_SCALE=3.0
AI_OCR_MIN_CONFIDENCE=0.85
AI_OCR_MAX_PIXELS=12000000
AI_MAX_PAGE_PARSE_SECONDS=10
AI_MAX_TOTAL_PARSE_SECONDS=120
AI_MAX_SVG_XREF_OBJECTS=100000
AI_MAX_SVG_OUTPUT_MB=128
# 单个画板的矢量 SVG 超过该体积时，图形部分栅格化为内嵌位图，文字仍保留为可编辑的 <text>。
AI_SVG_PAGE_RASTER_THRESHOLD_MB=8
AI_SVG_RASTER_DPI=150
AI_SVG_RASTER_MAX_PIXELS=40000000
AI_SVG_RASTER_FORMAT=jpeg
AI_SVG_RASTER_JPEG_QUALITY=85
# Docker 镜像已安装 Noto CJK；仅自定义字体时填写容器内路径。
AI_EXPORT_FONT_PATH=
GUNICORN_TIMEOUT=1800
LIBREOFFICE_SOFFICE_PATH=/usr/bin/libreoffice
LIBREOFFICE_PYTHON_PATH=/usr/bin/python3
LIBREOFFICE_TIMEOUT_SECONDS=60
PSD_NODE_PATH=/usr/local/bin/node
PSD_BRIDGE_PATH=/app/psd_runtime/bridge.cjs
PSD_PROCESS_TIMEOUT_SECONDS=120
PSD_NODE_MAX_OLD_SPACE_MB=512
PSD_IMAGEMAGICK_PATH=/usr/bin/convert
PSD_IMAGEMAGICK_TIMEOUT_SECONDS=90
ASPOSE_WORDS_LICENSE_PATH=

# Docker 镜像已内置 ODA。DWG 是压缩二进制格式；回写 DWG 可避免中间 ASCII DXF 膨胀数倍。
ODA_CONVERTER_PATH=/usr/local/bin/oda-file-converter-headless
ODA_CONVERTER_TIMEOUT_SECONDS=600
ODA_CONVERTER_DXF_VERSION=ACAD2018
DWG_EXPORT_TO_DWG=true

TM_VECTOR_ENABLED=false
TM_VECTOR_DIMENSIONS=128
TM_VECTOR_CANDIDATE_LIMIT=6
TM_VECTOR_SIMILARITY_FLOOR=0.45
TM_VECTOR_WEIGHT=0
TM_FUZZY_MATCH_BATCH_SIZE=5
TM_MATCH_STATEMENT_TIMEOUT_MS=8000
# 英文大批量匹配为选定的 5万—100万条 TM 建立事务内临时索引，单句编辑查询不启用。
TM_BATCH_SNAPSHOT_ENABLED=true
TM_BATCH_SNAPSHOT_MIN_QUERIES=100
TM_BATCH_SNAPSHOT_MAX_ENTRIES=1000000
# 文档统计专用 TM 单条查询超时（毫秒），不影响编辑器的 8 秒限制。
DOCUMENT_STATISTICS_TM_TIMEOUT_MS=120000

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3-flash-preview

# 可选：双文档对齐跨语言 embedding。不配置时自动降级。
ALIGNMENT_EMBEDDING_ENABLED=false
ALIGNMENT_EMBEDDING_API_KEY=
ALIGNMENT_EMBEDDING_BASE_URL=
ALIGNMENT_EMBEDDING_MODEL=google/gemini-embedding-2
ALIGNMENT_EMBEDDING_DIMENSIONS=768
ALIGNMENT_EMBEDDING_BATCH_SIZE=100
ALIGNMENT_EMBEDDING_CONCURRENCY=2
ALIGNMENT_EMBEDDING_WINDOW_BLOCKS=32
ALIGNMENT_LLM_REFINEMENT_ENABLED=true
ALIGNMENT_LLM_FULL_REVIEW_ENABLED=false
ALIGNMENT_LLM_FULL_REVIEW_MODEL=google/gemini-3.7-flash
ALIGNMENT_LLM_FULL_REVIEW_MAX_PAIRS=28
ALIGNMENT_LLM_FULL_REVIEW_MAX_CHARS=18000
ALIGNMENT_LLM_FULL_REVIEW_TABLE_MAX_PAIRS=24
ALIGNMENT_LLM_FULL_REVIEW_TABLE_MAX_CHARS=9000
ALIGNMENT_LLM_FULL_REVIEW_OVERLAP_PAIRS=2
ALIGNMENT_LLM_FULL_REVIEW_RETRY_MIN_PAIRS=4
ALIGNMENT_LLM_FULL_REVIEW_MAX_OUTPUT_TOKENS=4096
ALIGNMENT_LLM_FULL_REVIEW_CONCURRENCY=4
ONLINE_TERM_SEARCH_ENGINE=auto
ONLINE_TERM_SEARCH_MODEL=
ONLINE_TERM_SEARCH_MAX_RESULTS=5
ONLINE_TERM_SEARCH_MAX_USES=2

REFERENCE_LLM_API_KEY=
REFERENCE_LLM_BASE_URL=https://openrouter.ai/api/v1
REFERENCE_LLM_MODEL=google/gemini-3-flash-preview

LLM_TIMEOUT_SECONDS=60
LLM_STALL_TIMEOUT_SECONDS=120
LLM_MAX_CONCURRENCY=3
LLM_TEMPERATURE=0.2
LLM_RETRY_ATTEMPTS_PER_PROVIDER=2

STYLE_TAG_CHECK_LLM_PROVIDER=auto
STYLE_TAG_CHECK_LLM_MODEL=

LANGUAGETOOL_BASE_URL=http://languagetool:8010/v2
LANGUAGETOOL_TIMEOUT_SECONDS=10
LANGUAGETOOL_MAX_TEXT_LENGTH=20000
LANGUAGETOOL_LIVE_TIMEOUT_SECONDS=2.5
LANGUAGETOOL_LIVE_MAX_CONCURRENCY_PER_WORKER=2
LANGUAGETOOL_LIVE_QUEUE_TIMEOUT_SECONDS=0.3
LANGUAGETOOL_LIVE_CACHE_TTL_SECONDS=300
LANGUAGETOOL_JAVA_OPTIONS=-Xms512m -Xmx1536m
LANGUAGETOOL_MEMORY_LIMIT=2g
LANGUAGETOOL_CPU_LIMIT=2.0
SPELLING_GRAMMAR_QA_AUTO_SCHEDULE=false

JWT_SECRET_KEY=change-me-random-long-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
LOG_LEVEL=INFO

CORS_ALLOW_ORIGINS=["http://43.132.156.72","http://127.0.0.1","http://localhost"]
