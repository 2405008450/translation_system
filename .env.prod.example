TZ=Asia/Shanghai
POSTGRES_DB=tm_demo
POSTGRES_USER=tm_user
POSTGRES_PASSWORD=change-me-postgres-password

DATABASE_URL=postgresql+psycopg://tm_user:change-me-postgres-password@pgbouncer:6432/tm_demo
DATABASE_PGBOUNCER_TRANSACTION_MODE=true
DATABASE_APPLICATION_NAME=ai-translation-web
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=20
DATABASE_POOL_RECYCLE=1800
SERVER_THREADPOOL_SIZE=16
WEB_CONCURRENCY=4

TERM_IMPORT_PREVIEW_MAX_SCAN_ROWS=5000
RESOURCE_IMPORT_PREVIEW_MAX_SCAN_ROWS=1000
RESOURCE_IMPORT_BATCH_SIZE=500
RESOURCE_IMPORT_MAX_SIZE_MB=1024
RESOURCE_IMPORT_REQUEST_OVERHEAD_MB=10
APP_ENV_FILE=.env.prod

REDIS_URL=redis://redis:6379/0
IMPORT_QUEUE_BACKEND=arq
ARQ_MAX_JOBS=5
ARQ_IMPORT_MAX_JOBS=2
ARQ_MAINTENANCE_MAX_JOBS=2
ARQ_AUTO_TM_MAX_JOBS=1
ARQ_SEGMENT_SYNC_MAX_JOBS=1
ARQ_PRETRANSLATION_MAX_JOBS=2
ARQ_AI_MAX_JOBS=1
PRETRANSLATION_RUN_FILE_CONCURRENCY=2
AUTO_TM_OUTBOX_MAX_BATCHES_PER_RUN=5
AUTO_TM_REMATCH_MAX_FILES_PER_RUN=1

FILE_STORAGE_DIR=/app/data/file_records
EXPORT_TASK_DIR=/app/data/export_tasks
IMPORT_TASK_DIR=/app/data/import_tasks
IMPORT_TASK_STAGING_TTL_SECONDS=86400
UPLOAD_MAX_SIZE_MB=100
UPLOAD_MAX_FILES_PER_BATCH=50
UPLOAD_MAX_TOTAL_SIZE_MB=2048
UPLOAD_MAX_REQUEST_SIZE_MB=2060
UPLOAD_MAX_EXPANDED_FILES=100
AI_MAX_FILE_SIZE_MB=2048
AI_INLINE_MAX_SIZE_MB=100
AI_MIN_FREE_DISK_MB=8192
AI_WORKER_JOB_TIMEOUT_SECONDS=1800
AI_WORKER_MEMORY_LIMIT_MB=4096
AI_MAX_PAGES=200
AI_MAX_XREF_OBJECTS=250000
AI_MAX_TEXT_LINES=100000
AI_MAX_TEXT_SPANS=250000
AI_MAX_TEXT_CHARACTERS=5000000
AI_OCR_ENABLED=true
AI_OCR_SCALE=3.0
AI_OCR_MIN_CONFIDENCE=0.85
AI_OCR_MAX_PIXELS=12000000
AI_MAX_PAGE_PARSE_SECONDS=10
AI_MAX_TOTAL_PARSE_SECONDS=120
AI_MAX_SVG_XREF_OBJECTS=100000
AI_MAX_SVG_OUTPUT_MB=128
# 单个画板的矢量 SVG 超过该体积时，图形部分栅格化为内嵌位图，文字仍保留为可编辑的 <text>。
AI_SVG_PAGE_RASTER_THRESHOLD_MB=8
AI_SVG_RASTER_DPI=150
AI_SVG_RASTER_MAX_PIXELS=40000000
AI_SVG_RASTER_FORMAT=jpeg
AI_SVG_RASTER_JPEG_QUALITY=85
# Docker 镜像已安装 Noto CJK；仅自定义字体时填写容器内路径。
AI_EXPORT_FONT_PATH=
GUNICORN_TIMEOUT=1800
LIBREOFFICE_SOFFICE_PATH=/usr/bin/libreoffice
LIBREOFFICE_PYTHON_PATH=/usr/bin/python3
LIBREOFFICE_TIMEOUT_SECONDS=60
PSD_NODE_PATH=/usr/local/bin/node
PSD_BRIDGE_PATH=/app/psd_runtime/bridge.cjs
PSD_PROCESS_TIMEOUT_SECONDS=120
PSD_NODE_MAX_OLD_SPACE_MB=512
PSD_IMAGEMAGICK_PATH=/usr/bin/convert
PSD_IMAGEMAGICK_TIMEOUT_SECONDS=90
ASPOSE_WORDS_LICENSE_PATH=

TM_VECTOR_ENABLED=false
TM_VECTOR_DIMENSIONS=128
TM_VECTOR_CANDIDATE_LIMIT=6
TM_VECTOR_SIMILARITY_FLOOR=0.45
TM_VECTOR_WEIGHT=0
TM_FUZZY_MATCH_BATCH_SIZE=5
TM_MATCH_STATEMENT_TIMEOUT_MS=8000

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
