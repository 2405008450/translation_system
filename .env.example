# ========== 数据库 ==========
# 可选：应用版本号。生产环境通常通过 APP_VERSION=... docker compose ... --build 注入。
# APP_VERSION=dev
# SQLAlchemy 形式的 PostgreSQL 连接串（驱动使用 psycopg v3）
DATABASE_URL=postgresql+psycopg://tm_user:tm123456@localhost:5432/tm_demo
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=60
DATABASE_POOL_RECYCLE=1800
TERM_IMPORT_PREVIEW_MAX_SCAN_ROWS=5000
RESOURCE_IMPORT_PREVIEW_MAX_SCAN_ROWS=1000
RESOURCE_IMPORT_BATCH_SIZE=1000
RESOURCE_IMPORT_MAX_SIZE_MB=1024
# multipart 边界与表单字段的额外请求体空间。
RESOURCE_IMPORT_REQUEST_OVERHEAD_MB=10

# ========== 缓存（可选） ==========
# 若未配置 REDIS_URL，缓存将自动回退到进程内存
REDIS_URL=redis://127.0.0.1:6379/0

# ========== 导入队列 ==========
# local：由 FastAPI 后台任务处理；arq：投递到 Redis，需要另行启动 ARQ worker
IMPORT_QUEUE_BACKEND=local
ARQ_MAX_JOBS=1
# 不设置或设置为 0 时：导入/维护队列继承 ARQ_MAX_JOBS；预翻译队列默认 1。
# ARQ_IMPORT_MAX_JOBS=0
# ARQ_MAINTENANCE_MAX_JOBS=0
# ARQ_AUTO_TM_MAX_JOBS=0
# ARQ_SEGMENT_SYNC_MAX_JOBS=0
# ARQ_PRETRANSLATION_MAX_JOBS=0
# 单个预翻译批次内同时处理的文件数；生产环境建议先从 2 开始观察。
PRETRANSLATION_RUN_FILE_CONCURRENCY=2
AUTO_TM_OUTBOX_MAX_BATCHES_PER_RUN=5
AUTO_TM_REMATCH_MAX_FILES_PER_RUN=1

# ========== Word 文档统计（可选） ==========
# 配置 Aspose.Words 许可证后，DOCX 页数/字数/字符数统计会标记为 licensed。
ASPOSE_WORDS_LICENSE_PATH=
LIBREOFFICE_SOFFICE_PATH=
LIBREOFFICE_PYTHON_PATH=
LIBREOFFICE_TIMEOUT_SECONDS=60

# ========== PDF-compatible AI path-based 处理 ==========
# AI 超过 inline 阈值后必须进入 arq:ai 专用 worker；生产环境不得回退 Web 进程。
AI_MAX_FILE_SIZE_MB=2048
AI_INLINE_MAX_SIZE_MB=100
# 暂存大型 AI 前额外保留的可用磁盘空间。
AI_MIN_FREE_DISK_MB=8192
AI_WORKER_JOB_TIMEOUT_SECONDS=1800
AI_WORKER_MEMORY_LIMIT_MB=4096
ARQ_AI_MAX_JOBS=1
# Docker 镜像已安装 Noto CJK，通常无需设置。裸机 Linux 如需其他文字字体，填写 OTF/TTF/TTC 绝对路径。
# Linux 例：/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
AI_EXPORT_FONT_PATH=

# ========== PSD 文本图层处理（可选） ==========
# 默认自动查找 PATH 中的 node，并使用项目内 psd_runtime/bridge.cjs。
PSD_NODE_PATH=
PSD_BRIDGE_PATH=
PSD_PROCESS_TIMEOUT_SECONDS=120
PSD_NODE_MAX_OLD_SPACE_MB=512
# CMYK PSD 自动转换依赖 ImageMagick；留空时自动查找 magick（Linux 还会回退 convert）。
# Windows 例：C:\Program Files\ImageMagick-7.1.2-Q16-HDRI\magick.exe
# Linux   例：/usr/bin/magick 或 /usr/bin/convert
PSD_IMAGEMAGICK_PATH=
PSD_IMAGEMAGICK_TIMEOUT_SECONDS=90

# ========== ODA File Converter（DWG 支持，可选） ==========
# 安装 Open Design Alliance 的 File Converter 后，将可执行文件绝对路径填到这里。
# 未配置时 DWG 上传会失败并给出明确提示，DXF 不受影响。
# Windows 例：C:\Program Files\ODA\ODAFileConverter 25.12.0\ODAFileConverter.exe
# Linux   例：/usr/bin/ODAFileConverter
ODA_CONVERTER_PATH=
ODA_CONVERTER_TIMEOUT_SECONDS=120
ODA_CONVERTER_DXF_VERSION=ACAD2018
# 设为 true 时尝试把翻译结果回写为 DWG；失败会自动降级为 DXF
DWG_EXPORT_TO_DWG=false
# DWG 专用：启用文本语义重建（将同一行的多个 TEXT 实体合并为语义完整的句子再翻译）
DWG_ENABLE_SPATIAL_MERGE=true

# GPT-5.4 Mini：局部 CAD 文本结构化分组；Gemini Flash：低置信度语义复核
# 几何边界和表格单元格仍是硬约束，不允许模型跨框合并。
DWG_LLM_LAYOUT_ENABLED=true
DWG_LLM_LAYOUT_PROVIDER=openrouter
DWG_LLM_LAYOUT_MODEL=openai/gpt-5.4-mini
DWG_LLM_LAYOUT_MIN_BUCKET=2
DWG_LLM_LAYOUT_MAX_BUCKET=30
DWG_LLM_LAYOUT_CONCURRENCY=3
DWG_LLM_VERIFY_ENABLED=true
DWG_LLM_VERIFY_PROVIDER=openrouter
DWG_LLM_VERIFY_MODEL=google/gemini-2.5-flash
DWG_LLM_VERIFY_MIN_CONFIDENCE=0.40
DWG_LLM_VERIFY_MAX_CONFIDENCE=0.70
DWG_LLM_VERIFY_MAX_ITEMS=60

# ========== TM 向量检索 ==========
TM_VECTOR_ENABLED=true
TM_VECTOR_DIMENSIONS=128
TM_VECTOR_CANDIDATE_LIMIT=6
TM_VECTOR_SIMILARITY_FLOOR=0.45
TM_VECTOR_WEIGHT=0.35
TM_FUZZY_MATCH_BATCH_SIZE=50
TM_MATCH_STATEMENT_TIMEOUT_MS=45000

# ========== LLM 服务 ==========
# 至少配置一个 provider，否则 LLM 修正功能不可用
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# 可选示例：google/gemini-3-flash-preview、openai/gpt-5.4-mini、google/gemini-3.1-pro-preview、openai/gpt-5.5
OPENROUTER_MODEL=google/gemini-3-flash-preview

LLM_TIMEOUT_SECONDS=60
LLM_STALL_TIMEOUT_SECONDS=120
LLM_MAX_CONCURRENCY=20
LLM_TEMPERATURE=0.2
LLM_RETRY_ATTEMPTS_PER_PROVIDER=2

# ========== LanguageTool 拼写/语法 QA（可选） ==========
# 建议仅在内网部署自托管 LanguageTool，不调用公开云 API
LANGUAGETOOL_BASE_URL=http://languagetool:8010/v2
LANGUAGETOOL_TIMEOUT_SECONDS=10
LANGUAGETOOL_MAX_TEXT_LENGTH=20000
# 默认手动生成 QA，避免保存/确认句段时自动堆积后台任务。
SPELLING_GRAMMAR_QA_AUTO_SCHEDULE=false

# ========== 认证 ==========
# 务必替换为一段足够长的随机字符串，否则后端会拒绝启动
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ========== 文件上传 / 存储 ==========
FILE_STORAGE_DIR=data/file_records
EXPORT_TASK_DIR=data/export_tasks
IMPORT_TASK_DIR=data/import_tasks
IMPORT_TASK_STAGING_TTL_SECONDS=86400
UPLOAD_MAX_SIZE_MB=100
UPLOAD_MAX_FILES_PER_BATCH=50
UPLOAD_MAX_TOTAL_SIZE_MB=2048
# 由纯 ASGI 中间件同时检查 Content-Length 和实际接收字节，支持无头/chunked 请求。
UPLOAD_MAX_REQUEST_SIZE_MB=2060
UPLOAD_MAX_EXPANDED_FILES=100
# PDF-compatible AI 复杂度与 SVG 输出安全预算；AI 文件大小由 AI_MAX_FILE_SIZE_MB 控制。
AI_MAX_PAGES=200
AI_MAX_XREF_OBJECTS=250000
AI_MAX_TEXT_LINES=100000
AI_MAX_TEXT_SPANS=250000
AI_MAX_TEXT_CHARACTERS=5000000
# Illustrator 转曲文字 OCR：仅对检测到疑似字形路径的画板运行。
AI_OCR_ENABLED=true
AI_OCR_SCALE=3.0
AI_OCR_MIN_CONFIDENCE=0.85
AI_OCR_MAX_PIXELS=12000000
# 耗时限制在单页 native 调用返回后生效；硬超时需由独立 worker 进程负责。
AI_MAX_PAGE_PARSE_SECONDS=10
AI_MAX_TOTAL_PARSE_SECONDS=120
AI_MAX_SVG_XREF_OBJECTS=100000
AI_MAX_SVG_OUTPUT_MB=128
# 单个画板的矢量 SVG 超过该体积时，图形部分栅格化为内嵌位图，文字仍保留为可编辑的 <text>。
# 调小可显著减小输出体积，代价是更多画板失去矢量图形。
AI_SVG_PAGE_RASTER_THRESHOLD_MB=8
AI_SVG_RASTER_DPI=150
AI_SVG_RASTER_MAX_PIXELS=40000000
# jpeg 体积约为 png 的 1/10；底图为硬边线稿且不接受压缩振铃时改为 png。
AI_SVG_RASTER_FORMAT=jpeg
AI_SVG_RASTER_JPEG_QUALITY=85
DEFAULT_SIMILARITY_THRESHOLD=0.60

# ========== 日志 ==========
LOG_LEVEL=INFO
